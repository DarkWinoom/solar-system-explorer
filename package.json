{
  "name": "3d-earth-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A 3D Earth simulator with day/night cycle, auto-located visitor position, and procedural ambient music",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/three": "~0.185.0",
    "autoprefixer": "^10.4.17",
    "jsdom": "^23.0.1",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^1.1.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
