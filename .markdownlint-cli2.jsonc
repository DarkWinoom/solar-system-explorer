{
  "config": {
    "default": true,
    "MD013": { "line_length": 120, "tables": false, "code_blocks": false, "headings": false },
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD041": false,
    "MD060": { "style": "compact" }
  },
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    "README.md",
    "README.zh-CN.md",
    "NOTICES.md",
    "LICENSE"
  ]
}
