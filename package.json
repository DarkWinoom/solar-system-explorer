{
  "name": "3d-earth-simulator",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "A real-time 3D solar system explorer with eight planets, multilingual profiles, and ambient music",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "astronomy-engine": "2.1.19",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/three": "~0.185.0",
    "autoprefixer": "^10.4.17",
    "jsdom": "^23.0.1",
    "playwright": "^1.62.1",
    "postcss": "^8.4.33",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^1.1.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
